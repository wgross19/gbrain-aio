#!/command/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

# shellcheck disable=SC1091
. /usr/local/lib/gbrain-aio-lib.sh

load_runtime
wait_postgres
# Wait for first-boot config.json so this supervisor cannot create a
# default 1280-d schema before init writes embeddinggemma 768.
wait_config

exec gosu gbrain env HOME=/var/lib/gbrain \
  /usr/local/bin/gbrain jobs supervisor --nice 10
