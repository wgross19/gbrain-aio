#!/command/with-contenv bash
# shellcheck shell=bash
# Nightly 02:00 gbrain dream --dir. In-container s6 timer, not Hermes cron.
set -euo pipefail

# shellcheck disable=SC1091
. /usr/local/lib/gbrain-aio-lib.sh

load_runtime
wait_postgres
wait_config

while true; do
  /usr/local/bin/gbrain-sleep-until 02:00
  log "nightly dream --dir $(source_path)"
  /usr/local/bin/gbrain-dream-once || log "warn: nightly dream failed"
done
