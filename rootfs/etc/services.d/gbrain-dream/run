#!/command/with-contenv bash
# shellcheck shell=bash
# Nightly gbrain dream --dir at DREAM_AT (default 02:00). In-container s6 timer.
set -euo pipefail

# shellcheck disable=SC1091
. /usr/local/lib/gbrain-aio-lib.sh

load_runtime
wait_postgres
wait_config

while true; do
  /usr/local/bin/gbrain-sleep-until "$(dream_at)"
  log "nightly dream --dir $(source_path)"
  /usr/local/bin/gbrain-dream-once || log "warn: nightly dream failed"
done