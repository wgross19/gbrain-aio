#!/command/with-contenv bash
# shellcheck shell=bash
# Weekly Monday 06:00 gbrain doctor --json. In-container s6 timer, not Hermes cron.
set -euo pipefail

# shellcheck disable=SC1091
. /usr/local/lib/gbrain-aio-lib.sh

load_runtime
wait_postgres
wait_config

while true; do
  /usr/local/bin/gbrain-sleep-until monday 06:00
  log "weekly doctor"
  /usr/local/bin/gbrain-doctor-once || log "warn: weekly doctor failed"
done
