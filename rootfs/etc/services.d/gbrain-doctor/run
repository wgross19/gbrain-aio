#!/command/with-contenv bash
# shellcheck shell=bash
# Weekly doctor on DOCTOR_DAY at DOCTOR_AT (defaults: Monday 06:00).
set -euo pipefail

# shellcheck disable=SC1091
. /usr/local/lib/gbrain-aio-lib.sh

load_runtime
wait_postgres
wait_config

while true; do
  /usr/local/bin/gbrain-sleep-until "$(doctor_day)" "$(doctor_at)"
  log "weekly doctor"
  /usr/local/bin/gbrain-doctor-once || log "warn: weekly doctor failed"
done