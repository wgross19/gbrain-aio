#!/command/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

if [ -n "${AIO_APPDATA:-}" ]; then
	RT="${AIO_APPDATA}/gbrain-home/runtime.env"
else
	RT="${GBRAIN_HOME:-/var/lib/gbrain}/runtime.env"
fi
if [ -f "${RT}" ]; then
	set -a
	# shellcheck disable=SC1090,SC1091
	. "${RT}"
	set +a
fi

exec gosu postgres /usr/lib/postgresql/17/bin/postgres -D "${PGDATA:-/data/postgres}" -c listen_addresses=127.0.0.1
