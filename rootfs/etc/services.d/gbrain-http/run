#!/command/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }

if [ -f /var/lib/gbrain/runtime.env ]; then
  set -a
  # shellcheck disable=SC1091
  . /var/lib/gbrain/runtime.env
  set +a
fi

for _ in $(seq 1 60); do
  if pg_isready -h 127.0.0.1 -p 5432 >/dev/null 2>&1; then
    break
  fi
  sleep 1
done
if ! pg_isready -h 127.0.0.1 -p 5432 >/dev/null 2>&1; then
  log "postgres did not become ready"
  exit 1
fi

PGUSER_NAME="${POSTGRES_USER:-gbrain}"
PGDB_NAME="${POSTGRES_DB:-gbrain}"
export PGPASSWORD="${POSTGRES_PASSWORD:-}"

gosu postgres psql -v ON_ERROR_STOP=1 -d postgres <<SQL
DO \$\$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '${PGUSER_NAME}') THEN
    CREATE ROLE ${PGUSER_NAME} LOGIN PASSWORD '${POSTGRES_PASSWORD}';
  ELSE
    ALTER ROLE ${PGUSER_NAME} LOGIN PASSWORD '${POSTGRES_PASSWORD}';
  END IF;
END
\$\$;
ALTER ROLE ${PGUSER_NAME} WITH SUPERUSER BYPASSRLS;
SELECT 'CREATE DATABASE ${PGDB_NAME} OWNER ${PGUSER_NAME}'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '${PGDB_NAME}')\gexec
SQL

gosu postgres psql -v ON_ERROR_STOP=1 -d "${PGDB_NAME}" -c 'CREATE EXTENSION IF NOT EXISTS vector;'

# --- First-boot init + source registration --------------------------------
# If no config exists yet, initialize the brain against the internal Postgres
# and register the mounted source so a fresh install is ready without manual
# `docker exec` steps. Idempotent: skips once config.json exists.
if [ ! -f /var/lib/gbrain/.gbrain/config.json ]; then
  log "first boot: initializing brain (embeddinggemma 768d)"
  gosu gbrain env HOME=/var/lib/gbrain gbrain init \
    --url "${DATABASE_URL}" \
    --embedding-model ollama:embeddinggemma \
    --embedding-dimensions 768 \
    --non-interactive || log "warn: gbrain init failed (will retry next boot)"
  if [ -d "/${SOURCE_NAME}" ]; then
    log "first boot: registering source ${SOURCE_NAME}"
    gosu gbrain env HOME=/var/lib/gbrain gbrain sources add "${SOURCE_NAME}" \
      --path "/${SOURCE_NAME}" --name "${SOURCE_NAME}" \
      --force 2>/dev/null || log "warn: source registration failed (may need git init)"
  fi
fi

log "starting gbrain serve on 127.0.0.1:3131"
exec gosu gbrain /usr/local/bin/gbrain serve --http \
  --bind 127.0.0.1 \
  --port 3131 \
  --public-url "${GBRAIN_PUBLIC_URL:-https://192.168.1.10:3132}" \
  --surface full
