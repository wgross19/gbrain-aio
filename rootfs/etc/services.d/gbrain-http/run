#!/command/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }

if [ -f /var/lib/gbrain/runtime.env ]; then
  set -a
  # shellcheck disable=SC1091
  . /var/lib/gbrain/runtime.env
  set +a
fi

for _ in $(seq 1 60); do
  if pg_isready -h 127.0.0.1 -p 5432 >/dev/null 2>&1; then
    break
  fi
  sleep 1
done
if ! pg_isready -h 127.0.0.1 -p 5432 >/dev/null 2>&1; then
  log "postgres did not become ready"
  exit 1
fi

PGUSER_NAME="${POSTGRES_USER:-gbrain}"
PGDB_NAME="${POSTGRES_DB:-gbrain}"
export PGPASSWORD="${POSTGRES_PASSWORD:-}"

gosu postgres psql -v ON_ERROR_STOP=1 -d postgres <<SQL
DO \$\$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '${PGUSER_NAME}') THEN
    CREATE ROLE ${PGUSER_NAME} LOGIN PASSWORD '${POSTGRES_PASSWORD}';
  ELSE
    ALTER ROLE ${PGUSER_NAME} LOGIN PASSWORD '${POSTGRES_PASSWORD}';
  END IF;
END
\$\$;
ALTER ROLE ${PGUSER_NAME} WITH SUPERUSER BYPASSRLS;
SELECT 'CREATE DATABASE ${PGDB_NAME} OWNER ${PGUSER_NAME}'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '${PGDB_NAME}')\gexec
SQL

gosu postgres psql -v ON_ERROR_STOP=1 -d "${PGDB_NAME}" -c 'CREATE EXTENSION IF NOT EXISTS vector;'

log "starting gbrain serve on 127.0.0.1:3131"
exec gosu gbrain /usr/local/bin/gbrain serve --http \
  --bind 127.0.0.1 \
  --port 3131 \
  --public-url "${GBRAIN_PUBLIC_URL:-https://192.168.1.10:3132}" \
  --surface full
