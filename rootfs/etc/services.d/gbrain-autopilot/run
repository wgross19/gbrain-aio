#!/command/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

# shellcheck disable=SC1091
. /usr/local/lib/gbrain-aio-lib.sh

load_runtime
wait_postgres
wait_config

PATH_BRAIN="$(source_path)"

if [ -n "${BRAIN_GIT_PUSH_URL:-}" ]; then
  /usr/local/bin/gbrain-push-after-cycle &
fi

log "starting gbrain autopilot --repo ${PATH_BRAIN} --interval 1800 --no-worker"
exec gosu gbrain env HOME=/var/lib/gbrain \
  /usr/local/bin/gbrain autopilot --repo "${PATH_BRAIN}" --interval 1800 --no-worker
