#!/command/with-contenv bash
# shellcheck shell=bash
# After serve is up, enqueue one source-scoped sync. Does not block HTTP.
set -euo pipefail

# shellcheck disable=SC1091
. /usr/local/lib/gbrain-aio-lib.sh

load_runtime

MARKER="${GBRAIN_HOME:-/var/lib/gbrain}"/.gbrain/need-first-sync
DONE="${GBRAIN_HOME:-/var/lib/gbrain}"/.gbrain/first-sync.enqueued
if [ ! -f "${MARKER}" ]; then
  exit 0
fi

NAME="$(source_name)"
for _ in $(seq 1 90); do
  if curl -fsS http://127.0.0.1:3131/health >/dev/null 2>&1; then
    break
  fi
  sleep 2
done
if ! curl -fsS http://127.0.0.1:3131/health >/dev/null 2>&1; then
  log "serve not healthy; skip first sync enqueue"
  exit 0
fi

PARAMS="$(printf '{"sourceId":"%s"}' "${NAME}")"
log "enqueue source-scoped sync for ${NAME}"
JOB_ID="$(gbrain_as gbrain jobs submit sync \
  --params "${PARAMS}" \
  --idempotency-key "first-boot-sync:${NAME}" 2>/dev/null | tail -1 || true)"
if [ -n "${JOB_ID:-}" ]; then
  printf '%s\n' "${JOB_ID}" > "${GBRAIN_HOME:-/var/lib/gbrain}"/.gbrain/first-sync.job
  chown gbrain:users "${GBRAIN_HOME:-/var/lib/gbrain}"/.gbrain/first-sync.job || true
  log "first sync job recorded: ${JOB_ID}"
fi
rm -f "${MARKER}"
touch "${DONE}"
chown gbrain:users "${DONE}" || true
