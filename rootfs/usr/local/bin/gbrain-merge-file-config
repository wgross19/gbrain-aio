#!/usr/bin/env bun
/**
 * Merge self-sufficient defaults into file-plane config.json.
 * File-plane is canonical. Prints dotted DB-plane keys to stdout as JSON
 * so the caller can mirror them into the config table getConfig() reads.
 *
 * XML-trigger model: every decision here reads an env var with a generic
 * default. The Unraid XML <Config> surface mirrors those vars.
 */
import { readFileSync, writeFileSync, mkdirSync, chmodSync, existsSync } from "fs";
import { dirname } from "path";

function isOn(value: string | undefined): boolean {
  return ["1", "true", "yes", "on"].includes((value ?? "").trim().toLowerCase());
}

function normalizeOllamaV1(raw: string): string {
  const base = raw.replace(/\/+$/, "");
  if (!base) return "";
  return base.endsWith("/v1") ? base : `${base}/v1`;
}

function asRecord(value: unknown): Record<string, unknown> {
  return value && typeof value === "object" && !Array.isArray(value)
    ? (value as Record<string, unknown>)
    : {};
}

/** Set a dotted key path ("models.drift") inside a nested record. */
function setDotted(obj: Record<string, unknown>, path: string, value: unknown): void {
  const parts = path.split(".");
  let cursor = obj;
  for (let i = 0; i < parts.length - 1; i++) {
    const key = parts[i];
    if (
      cursor[key] === undefined ||
      cursor[key] === null ||
      typeof cursor[key] !== "object" ||
      Array.isArray(cursor[key])
    ) {
      cursor[key] = {};
    }
    cursor = cursor[key] as Record<string, unknown>;
  }
  cursor[parts[parts.length - 1]] = value;
}

const configPath = process.env.CONFIG_PATH || (process.env.GBRAIN_HOME || "/var/lib/gbrain") + "/.gbrain/config.json";
const sourcePath = process.env.SOURCE_PATH || "";
const ollamaBase = (process.env.OLLAMA_BASE_URL || "").trim();
const chatModelName = (process.env.CHAT_MODEL || "deepseek-v4-flash:cloud").trim();
// CHAT_PROVIDER: "" (auto: ollama when OLLAMA_BASE_URL set), "ollama", or
// "together" (legacy redirect mode; kept for existing installs).
const chatProvider = (process.env.CHAT_PROVIDER || "").trim().toLowerCase();
const applyChatGated = isOn(process.env.APPLY_CHAT_GATED) || ollamaBase.length > 0;

let cfg: Record<string, unknown> = {};
if (existsSync(configPath)) {
  cfg = JSON.parse(readFileSync(configPath, "utf8")) as Record<string, unknown>;
}

// --- Embedding + schema (overridable; defaults are the proven keyless set) ---
cfg.embedding_model = (process.env.EMBEDDING_MODEL || "").trim() || "ollama:embeddinggemma";
const dimsRaw = (process.env.EMBEDDING_DIMENSIONS || "").trim();
cfg.embedding_dimensions = Number.parseInt(dimsRaw, 10) || 768;

if (sourcePath) {
  const sync = asRecord(cfg.sync);
  sync.repo_path = sourcePath;
  cfg.sync = sync;
}

cfg.schema_pack = (process.env.SCHEMA_PACK || "").trim() || "gbrain-everything";

const mcp = asRecord(cfg.mcp);
mcp.publish_skills = true;
mcp.publish_advisor = true;
// Bundle ships the curated brain-operation skills at /opt/gbrain/skills
// (manifest.json). Remote MCP list_skills/get_skill have no install-path
// auto-detect by design, so an explicit skills_dir is required for the
// catalog to be reachable over MCP. Full catalog by default.
mcp.skills_dir = "/opt/gbrain/skills";
cfg.mcp = mcp;

const dbFlags: Record<string, string> = {
  "mcp.publish_skills": "true",
  "mcp.publish_advisor": "true",
  "mcp.skills_dir": "/opt/gbrain/skills",
};

if (sourcePath) {
  dbFlags["sync.repo_path"] = sourcePath;
}

// --- Chat provider routing ---------------------------------------------------
// Default follows the raw runtime: the ollama recipe has full chat touchpoints
// since the local-first wave; OLLAMA_BASE_URL is read by the runtime directly.
// "together" keeps the historical provider_base_urls redirect working.
if (ollamaBase) {
  if (chatProvider === "together") {
    cfg.chat_model = `together:${chatModelName}`;
    cfg.expansion_model = `together:${chatModelName}`;
    const bases = asRecord(cfg.provider_base_urls);
    bases.together = normalizeOllamaV1(ollamaBase);
    cfg.provider_base_urls = bases;
  } else {
    cfg.chat_model = `ollama:${chatModelName}`;
    cfg.expansion_model = `ollama:${chatModelName}`;
  }
}

const autopilot = asRecord(cfg.autopilot);
if (isOn(process.env.NIGHTLY_QUALITY_PROBE)) {
  const probe = asRecord(autopilot.nightly_quality_probe);
  probe.enabled = true;
  autopilot.nightly_quality_probe = probe;
}
if (isOn(process.env.PARSER_PROBE_ENABLED)) {
  const probe = asRecord(autopilot.conversation_parser_probe);
  probe.enabled = true;
  autopilot.conversation_parser_probe = probe;
}
if (Object.keys(autopilot).length > 0) {
  cfg.autopilot = autopilot;
}

if (applyChatGated) {
  const dream = asRecord(cfg.dream);
  const drift = asRecord(dream.drift);
  drift.enabled = true;
  dream.drift = drift;
  cfg.dream = dream;

  const cycle = asRecord(cfg.cycle);
  const enrich = asRecord(cycle.enrich_thin);
  enrich.enabled = true;
  cycle.enrich_thin = enrich;
  const facts = asRecord(cycle.conversation_facts_backfill);
  facts.enabled = true;
  cycle.conversation_facts_backfill = facts;
  const grade = asRecord(cycle.grade_takes);
  const autoResolve = asRecord(grade.auto_resolve);
  autoResolve.enabled = true;
  grade.auto_resolve = autoResolve;
  cycle.grade_takes = grade;
  cfg.cycle = cycle;

  const parser = asRecord(cfg.conversation_parser);
  parser.llm_fallback_enabled = true;
  cfg.conversation_parser = parser;

  dbFlags["dream.drift.enabled"] = "true";
  dbFlags["cycle.enrich_thin.enabled"] = "true";
  dbFlags["cycle.conversation_facts_backfill.enabled"] = "true";
  dbFlags["cycle.grade_takes.auto_resolve.enabled"] = "true";
  dbFlags["conversation_parser.llm_fallback_enabled"] = "true";
}

if (isOn(process.env.SKILLOPT_ENABLED)) {
  const cycle = asRecord(cfg.cycle);
  const skillopt = asRecord(cycle.skillopt);
  skillopt.enabled = true;
  cycle.skillopt = skillopt;
  cfg.cycle = cycle;
  dbFlags["cycle.skillopt.enabled"] = "true";
}

// --- GBRAIN_EXTRA_CONFIG: universal passthrough ------------------------------
// Comma/newline-separated key=value pairs. Sets ANY runtime config key from
// the XML (e.g. models.drift=..., dream.triage.threshold=0.6). Applied last:
// explicit passthrough beats the defaults above. provider_base_urls is
// denylisted: native base-url folds are file-plane-only by mount safety.
const extraRaw = (process.env.GBRAIN_EXTRA_CONFIG || "").trim();
if (extraRaw) {
  for (const pair of extraRaw.split(/[,\n]/).map((p) => p.trim()).filter(Boolean)) {
    const eq = pair.indexOf("=");
    if (eq <= 0) {
      throw new Error(`GBRAIN_EXTRA_CONFIG: invalid entry (need key=value): ${pair}`);
    }
    const key = pair.slice(0, eq).trim();
    const value = pair.slice(eq + 1).trim();
    if (!/^[a-z0-9_.]+$/.test(key)) {
      throw new Error(`GBRAIN_EXTRA_CONFIG: invalid config key: ${key}`);
    }
    if (key === "provider_base_urls" || key.startsWith("provider_base_urls.")) {
      throw new Error(
        `GBRAIN_EXTRA_CONFIG: refusing ${key} — provider base URLs are file-plane-only by mount safety`,
      );
    }
    let typed: unknown = value;
    if (value === "true") typed = true;
    else if (value === "false") typed = false;
    else if (/^-?\d+(\.\d+)?$/.test(value)) typed = Number(value);
    setDotted(cfg, key, typed);
    dbFlags[key] = value;
  }
}

mkdirSync(dirname(configPath), { recursive: true });
writeFileSync(configPath, JSON.stringify(cfg, null, 2) + "\n", { mode: 0o600 });
try {
  chmodSync(configPath, 0o600);
} catch {
  /* best-effort */
}

process.stdout.write(JSON.stringify(dbFlags) + "\n");