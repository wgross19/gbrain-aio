# Copy to .env and fill secrets. Mode 0600. Never commit .env.
# POSTGRES_PASSWORD and GBRAIN_ADMIN_BOOTSTRAP_TOKEN must be alphanumeric (A-Za-z0-9).

GBRAIN_GIT_SHA=864dec4f199f420dba1ea6c5bc72e824e09de978
POSTGRES_USER=gbrain
POSTGRES_PASSWORD=replaceWithAlnumOnly
POSTGRES_DB=gbrain
GBRAIN_HOST_PORT=3132
GBRAIN_LAN_BIND=192.168.1.10
GBRAIN_PUBLIC_URL=https://192.168.1.10:3132
GBRAIN_ADMIN_BOOTSTRAP_TOKEN=replaceWithAlnumOnly
BRAIN_PATH=/mnt/user/my-brain
SOURCE_NAME=my-brain
BRAIN_UID=999
BRAIN_GID=100
APPDATA_ROOT=/mnt/user/appdata/Compose/gbrain-vanilla
OLLAMA_BASE_URL=http://192.168.1.10:11434/v1
OLLAMA_API_KEY=ollama
TOGETHER_API_KEY=ollama
GBRAIN_VANILLA_IMAGE=gbrain-vanilla-aio:v0.46.14.0
