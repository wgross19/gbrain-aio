# =============================================================================
# gbrain-aio — .env reference for the Unraid DockerMan XML template
# =============================================================================
# Copy this file to ".env" (mode 0600) and fill the secrets. NEVER commit .env.
#
# DockerMan XML mapping:
#   Every variable below becomes one <Config> row in the template. The XML
#   "Target" is the variable name; the "Name" is the human label in the Unraid
#   UI. Secrets (POSTGRES_PASSWORD, GBRAIN_ADMIN_BOOTSTRAP_TOKEN) should be
#   Type="Variable" with Mode="rw" and marked as sensitive in the template.
#
# SECURITY:
#   - POSTGRES_PASSWORD and GBRAIN_ADMIN_BOOTSTRAP_TOKEN MUST be alphanumeric
#     (A-Za-z0-9). The bootstrap script rejects anything else.
#   - Never publish 5432. Never give agents DATABASE_URL.
# =============================================================================

# --- Build pin (Unraid: not a UI field; set by the App Factory pipeline) ----
# Official garrytan/gbrain commit this image is built from. Bump to upgrade.
GBRAIN_GIT_SHA=864dec4f199f420dba1ea6c5bc72e824e09de978

# --- Postgres (Unraid: <Config ... Type="Variable"/>) ----------------------
# Superuser name. Keep "gbrain".
POSTGRES_USER=gbrain
# REQUIRED. Alphanumeric only. Secret.
POSTGRES_PASSWORD=replaceWithAlnumOnly
# Database name. Keep "gbrain".
POSTGRES_DB=gbrain

# --- HTTPS publish (Unraid: <Config ... Type="Port"/> + Variable) -----------
# Host port for the published HTTPS endpoint. Keep 3132.
GBRAIN_HOST_PORT=3132
# LAN IP the container binds. Set to your Unraid host LAN IP.
GBRAIN_LAN_BIND=192.168.1.10
# Public HTTPS origin clients use. Must match GBRAIN_LAN_BIND + port.
GBRAIN_PUBLIC_URL=https://192.168.1.10:3132
# Admin bootstrap token for first /admin login. Alphanumeric. Secret.
GBRAIN_ADMIN_BOOTSTRAP_TOKEN=replaceWithAlnumOnly

# --- Brain repo (Unraid: <Config ... Type="Path"/>) -------------------------
# Host path to the brain markdown repo. Must be a git repo.
BRAIN_PATH=/mnt/user/my-brain
# Name of the mounted source. MUST equal basename(BRAIN_PATH).
SOURCE_NAME=my-brain
# UID/GID for the brain bind mount. Unraid default is 99:100.
BRAIN_UID=999
BRAIN_GID=100

# --- App data (Unraid: <Config ... Type="Path"/>) ---------------------------
# Parent dir for the three persistent volumes (data/postgres, gbrain-home,
# caddy). The template exposes each sub-path as its own Path row.
APPDATA_ROOT=/mnt/user/appdata/Compose/gbrain-aio

# --- Ollama (Unraid: <Config ... Type="Variable"/>) -------------------------
# openai-compat endpoint for embeddings + chat. Point at your Ollama host.
OLLAMA_BASE_URL=http://192.168.1.10:11434/v1
# Ollama API key. "ollama" is the default for a local Ollama.
OLLAMA_API_KEY=ollama
# Together-compat key used to route chat/dream/think through Ollama /v1.
TOGETHER_API_KEY=ollama

# --- Image (Unraid: <Repository>) -------------------------------------------
# Prebuilt image the template installs. Overridable.
GBRAIN_AIO_IMAGE=gbrain-aio:v0.46.14.0
